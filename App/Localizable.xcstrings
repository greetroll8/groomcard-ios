          }
        }
      }
    },
    "Your pets, owners, sessions and photos always stay visible — Pro only unlocks unlimited pets, PDF reports and CSV export.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши питомцы, владельцы, сеансы и фото всегда остаются доступными — Pro открывает только неограниченное число питомцев, PDF-отчёты и экспорт в CSV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tiere, Besitzer, Sitzungen und Fotos bleiben immer sichtbar – Pro schaltet nur unbegrenzte Tiere, PDF-Berichte und CSV-Export frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
